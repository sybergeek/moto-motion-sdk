{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moto-motion.performance-log.v1",
  "type": "object",
  "required": ["reel", "observed_at"],
  "properties": {
    "reel": {"type": "integer", "minimum": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": ["number", "null"]},
    "views": {"type": ["integer", "null"]},
    "unique_viewers": {"type": ["integer", "null"]},
    "reach": {"type": ["integer", "null"]},
    "average_watch_time_seconds": {"type": ["number", "null"]},
    "watch_time_percentage": {"type": ["number", "null"]},
    "skip_rate": {"type": ["number", "null"]},
    "retention_curve": {"type": ["array", "null"], "items": {"type": "object"}},
    "retention_at_seconds": {"type": ["object", "null"]},
    "early_dropoff": {"type": ["number", "null"]},
    "completion_rate": {"type": ["number", "null"]},
    "shares": {"type": ["integer", "null"]},
    "likes": {"type": ["integer", "null"]},
    "comments": {"type": ["integer", "null"]},
    "saves": {"type": ["integer", "null"]},
    "reposts": {"type": ["integer", "null"]},
    "profile_visits_attributed": {"type": ["integer", "null"]},
    "follows_attributed": {"type": ["integer", "null"]},
    "net_account_follower_change": {"type": ["integer", "null"]},
    "observation_start": {"type": ["string", "null"], "format": "date"},
    "observation_end": {"type": ["string", "null"], "format": "date"},
    "hook_type": {"type": ["string", "null"]},
    "narrative_structure": {"type": ["string", "null"]},
    "techniques": {"type": "array", "items": {"type": "string"}},
    "observations": {"type": "array", "items": {"type": "string"}},
    "hypotheses": {"type": "array", "items": {"type": "string"}},
    "comparison_context": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
